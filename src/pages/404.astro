---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex={true}>
  <section class="section" style="text-align:center;padding-block:var(--s9)">
    <div class="wrap" style="max-width:52ch">
      <p class="eyebrow">404</p>
      <h1>That page does not exist</h1>
      <p class="lede center" style="margin-top:var(--s5)">
        The link may be out of date. Try the services overview, or just tell us what you need.
      </p>
      <div style="display:flex;gap:var(--s3);justify-content:center;flex-wrap:wrap;margin-top:var(--s6)">
        <a href="/" class="btn btn--primary">Back to home</a>
        <a href="/services/" class="btn btn--ghost">View services</a>
      </div>
    </div>
  </section>
</Base>
