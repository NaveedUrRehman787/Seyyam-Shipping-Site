---
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Icon from '../components/Icon.astro';
import { site, offices } from '../data/site.js';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  mainEntity: {
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    contactPoint: offices.map((o) => ({
      '@type': 'ContactPoint',
      telephone: o.phone,
      contactType: 'sales',
      areaServed: o.flag,
      availableLanguage: ['English'],
      name: o.label,
    })),
  },
};
---
<Base title="Contact us" description="Reach Nova Source in Islamabad, Kabul, Jalalabad, Dubai or Yiwu. Send your product and destination — we reply within one business day." schema={schema}>
  <section class="section ct-hero">
    <div class="wrap" style="max-width:62ch">
      <p class="eyebrow">Contact</p>
      <h1>Tell us what you are sourcing</h1>
      <p class="lede" style="margin-top:var(--s5)">
        The more specific you are — product, quantity, destination country, deadline — the more
        useful our first reply will be. You will get a confirmation email immediately and a real
        answer within one business day.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap ct-grid">
      <div class="ct-info">
        <h2>Our offices</h2>
        <ul class="office-list">
          {offices.map((o) => (
            <li class:list={[{ 'is-primary': o.primary }]}>
              <div class="office-list__head">
                <strong>{o.label}</strong>
                {o.primary && <span class="badge">Main business number</span>}
              </div>
              <span class="office-list__addr">{o.address}</span>
              <a href={`tel:${o.phoneHref}`}>{o.phone}</a>
              {o.altPhone && (
                <a href={`tel:${o.altPhoneHref}`}>{o.altPhone} <span class="ct-sub-inline">(alt)</span></a>
              )}
              {o.whatsapp && (
                <a class="wa-link" href={`https://wa.me/${o.whatsapp}`} target="_blank" rel="noopener noreferrer">
                  WhatsApp
                </a>
              )}
            </li>
          ))}
        </ul>

        <ul class="contact-list" style="margin-top:var(--s7)">
          <li>
            <Icon name="mail" size={18} />
            <div><strong>Email</strong><a href={`mailto:${site.email}`}>{site.email}</a></div>
          </li>
          <li>
            <Icon name="clock" size={18} />
            <div><strong>Hours</strong><span>Mon–Sat, 09:00–18:00 (local office time)</span></div>
          </li>
        </ul>

        <div class="ct-note">
          <p><strong>Working across time zones?</strong> Say so in your message and we will
          schedule a call inside your working hours rather than ours.</p>
        </div>
      </div>

      <div><QuoteForm title="Send your request" blurb="Every field except phone is required. It takes about a minute." /></div>
    </div>
  </section>
</Base>

<style>
  .ct-hero {
    background:
      linear-gradient(180deg, #0c2430 0%, #0a1c28 100%);
    border-bottom: 1px solid rgb(13 138 143 / .25);
    color: #a8c0cb;
  }
  .ct-hero h1 { color: #fff; }
  .ct-hero .eyebrow { color: var(--accent); }
  .ct-hero .lede { color: #a8c0cb; }
  .ct-grid { display: grid; gap: var(--s8); align-items: start; }
  @media (min-width: 950px) { .ct-grid { grid-template-columns: .9fr 1.1fr; gap: var(--s9); } }
  .ct-info h2 { font-size: var(--f-lg); }

  .office-list { list-style: none; padding: 0; display: grid; gap: var(--s4);
                 margin-top: var(--s6); }
  .office-list li {
    padding: var(--s4); border: 1px solid var(--line); border-radius: var(--radius-lg);
    background: #fff; display: grid; gap: .35rem;
  }
  .office-list li.is-primary {
    border-color: var(--sea);
    box-shadow: 0 0 0 1px rgb(13 138 143 / .2);
  }
  .office-list__head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2); }
  .office-list__head strong { font-size: var(--f-sm); color: var(--ink); }
  .badge {
    font-size: .7rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    color: var(--sea); background: var(--sea-soft); padding: .2rem .5rem; border-radius: 999px;
  }
  .office-list__addr { font-size: var(--f-xs); color: var(--muted); }
  .office-list a {
    color: var(--ink); text-decoration: none; font-weight: 650; font-size: var(--f-sm);
  }
  .office-list a:hover { color: var(--sea); }
  .wa-link { color: var(--sea) !important; font-weight: 600; }
  .ct-sub-inline { font-weight: 400; color: var(--muted); font-size: var(--f-xs); }

  .contact-list { list-style: none; padding: 0; display: grid; gap: var(--s5); }
  .contact-list li { display: grid; grid-template-columns: 22px 1fr; gap: var(--s4);
                     align-items: start; }
  .contact-list svg { margin-top: .3em; color: var(--accent); }
  .contact-list strong { display: block; font-size: var(--f-xs); text-transform: uppercase;
                         letter-spacing: .08em; color: var(--muted); margin-bottom: .2rem; }
  .contact-list a { display: block; color: var(--ink); text-decoration: none; font-weight: 600;
                    font-size: var(--f-sm); }
  .contact-list a:hover { color: var(--accent); }
  .contact-list span { display: block; font-size: var(--f-sm); }

  .ct-note { margin-top: var(--s7); padding: var(--s5); border-radius: var(--radius);
             background: var(--sea-soft); border-left: 3px solid var(--sea); }
  .ct-note p { font-size: var(--f-sm); color: var(--ink-2); }
</style>
