---
import { site, nav } from '../data/site.js';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
const isActive = (href) => href === '/' ? path === '/' : path.startsWith(href);
---
<div class="topbar">
  <div class="wrap topbar__in">
    <span>{site.tagline}</span>
    <a href={`tel:${site.phoneHref}`} class="topbar__tel">
      <Icon name="phone" size={14} /> {site.phone}
    </a>
  </div>
</div>

<header class="hdr" id="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
        <span class="brand__mark" aria-hidden="true">S</span>
      <span class="brand__text">{site.name}</span>
    </a>

    <nav class="nav" id="nav" aria-label="Main">
      <ul class="nav__list">
        {nav.map((item) => (
          <li class={item.children ? 'nav__item nav__item--has-sub' : 'nav__item'}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
              {item.children && <span class="nav__caret" aria-hidden="true">▾</span>}
            </a>
            {item.children && (
              <ul class="subnav">
                {item.children.map((c) => (
                  <li><a href={c.href}>{c.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a href="/contact-us/" class="btn btn--primary hdr__cta">Get a Quote</a>

    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="nav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .topbar {
    background: linear-gradient(90deg, #071422 0%, #0a2a32 55%, #071422 100%);
    color: #8eabb5; font-size: var(--f-xs);
    border-bottom: 1px solid rgb(13 138 143 / .25);
  }
  .topbar__in { display: flex; justify-content: space-between; align-items: center;
                gap: var(--s4); min-height: 38px; }
  .topbar__tel { display: inline-flex; align-items: center; gap: .4rem;
                 color: var(--accent); text-decoration: none; font-weight: 650; }
  .topbar__tel:hover { color: #e0c04a; }
  @media (max-width: 640px) { .topbar__in > span { display: none; }
                              .topbar__in { justify-content: flex-end; } }

  .hdr { position: sticky; top: 0; z-index: 100; background: rgb(245 249 250 / .9);
         backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .hdr__in { display: flex; align-items: center; gap: var(--s5); min-height: 72px; }

  .brand { display: inline-flex; align-items: center; gap: var(--s3);
           text-decoration: none; margin-right: auto; }
  .brand__mark {
    width: 36px; height: 36px; border-radius: 8px; display: grid;
    place-items: center; background: var(--ink); color: var(--accent);
    font-weight: 800; font-size: 1.15rem;
    box-shadow: inset 0 0 0 1.5px rgb(13 138 143 / .55);
  }
  .brand__text { font-weight: 700; color: var(--ink); font-size: var(--f-md);
                 letter-spacing: -.02em; }

  .nav__list { display: flex; gap: var(--s5); list-style: none; margin: 0; padding: 0; }
  .nav__item { position: relative; }
  .nav__item > a { display: inline-flex; align-items: center; gap: .3rem;
                   text-decoration: none; color: var(--ink); font-weight: 600;
                   font-size: var(--f-sm); padding-block: .5rem; }
  .nav__item > a[aria-current='page'] { color: var(--sea); }
  .nav__caret { font-size: .6em; opacity: .6; }

  .subnav { position: absolute; top: 100%; left: calc(-1 * var(--s4)); min-width: 265px;
            background: #fff; border: 1px solid var(--line); border-radius: var(--radius);
            box-shadow: var(--shadow-lg); padding: var(--s2); list-style: none; margin: 0;
            opacity: 0; visibility: hidden; transform: translateY(6px);
            transition: all .18s var(--ease); }
  .nav__item--has-sub:hover .subnav,
  .nav__item--has-sub:focus-within .subnav { opacity: 1; visibility: visible; transform: none; }
  .subnav a { display: block; padding: .6rem .8rem; border-radius: 6px;
              text-decoration: none; color: var(--body); font-size: var(--f-sm); }
  .subnav a:hover { background: var(--sea-soft); color: var(--ink); }

  .burger { display: none; flex-direction: column; gap: 5px; background: none;
            border: 0; cursor: pointer; padding: 8px; }
  .burger span { width: 24px; height: 2px; background: var(--ink); border-radius: 2px;
                 transition: transform .2s var(--ease), opacity .2s var(--ease); }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 940px) {
    .burger { display: flex; }
    .hdr__cta { display: none; }
    .nav { position: fixed; inset: 110px 0 auto 0; background: var(--bg);
           border-bottom: 1px solid var(--line); padding: var(--s4) var(--s5) var(--s6);
           max-height: calc(100dvh - 110px); overflow-y: auto;
           display: none; }
    .nav.is-open { display: block; }
    .nav__list { flex-direction: column; gap: 0; }
    .nav__item { border-bottom: 1px solid var(--line); }
    .nav__item > a { padding: var(--s4) 0; font-size: var(--f-base); }
    .subnav { position: static; opacity: 1; visibility: visible; transform: none;
              box-shadow: none; border: 0; padding: 0 0 var(--s3) var(--s4); }
  }
</style>

<script>
  const burger = document.getElementById('burger');
  const navEl  = document.getElementById('nav');
  burger?.addEventListener('click', () => {
    const open = navEl.classList.toggle('is-open');
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
  navEl?.addEventListener('click', (e) => {
    if (e.target.tagName === 'A' && window.innerWidth <= 940) {
      navEl.classList.remove('is-open');
      burger.setAttribute('aria-expanded', 'false');
    }
  });
</script>
